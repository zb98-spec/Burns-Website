SECRET_KEY=change-me
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
PORT=8080
# Uncomment if testing locally against a real Postgres DATABASE_URL over
# plain HTTP — otherwise the session cookie's Secure flag drops it.
# SESSION_COOKIE_SECURE=false

# Investing API (separate service — see INVESTMENT_ENGINE_HANDOFF.md).
# Local dev value matches the Investing-API repo's docker-compose.yml.
INVESTING_API_URL=http://localhost:8000
INVESTING_API_KEY=local-dev-key
